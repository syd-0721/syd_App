# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEPSEEK_API_KEY: Optional DeepSeek API key for server-side /api/ai-analyze proxy.
# If configured, the server calls https://api.deepseek.com/chat/completions (deepseek-chat).
# Otherwise, it seamlessly uses the server-side AI engine for financial analysis.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
